# ── Lumiq Digital Solutions — env template ──
# Copy this file to `.env.local` (gitignored) and fill in real values.
# All variables MUST be prefixed with `VITE_` to be exposed to the client.

# Public site URL (used in canonical link, share metadata)
VITE_SITE_URL=https://lumiq.tech

# Contact details shown in footer and CTA
VITE_CONTACT_EMAIL=hello@lumiq.tech
VITE_CONTACT_PHONE=+256700000000
VITE_CONTACT_PHONE_DISPLAY=+256 700 000 000

# Social links (override per-environment if needed)
VITE_SOCIAL_X=https://x.com/lumiqdigital
VITE_SOCIAL_GITHUB=https://github.com/lumiqdigital
VITE_SOCIAL_LINKEDIN=https://www.linkedin.com/company/lumiqdigital
